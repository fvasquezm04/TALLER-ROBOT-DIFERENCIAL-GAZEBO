<?xml version="1.0"?>

<sdf version="1.9">

  <world name="mundo">

    <!-- Configuración física -->

    <physics name="fisica" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistemas necesarios de Gazebo -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Sistema necesario para actualizar camaras y LiDAR -->

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <!-- Configuración visual -->

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Luz principal -->

    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>

    </light>

    <!-- Suelo -->

    <model name="suelo">

      <static>true</static>

      <link name="suelo_link">

        <collision name="suelo_collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>

        </collision>

        <visual name="suelo_visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.65 0.65 0.65 1.0</ambient>
            <diffuse>0.65 0.65 0.65 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>

        </visual>

      </link>

    </model>

    <!-- Obstaculo frontal -->

    <model name="obstaculo_frontal">
      <static>true</static>

      <pose>2.0 0.0 0.50 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 1.50 1.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 1.50 1.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Obstaculo izquierdo -->

    <model name="obstaculo_izquierdo">
      <static>true</static>

      <pose>0.0 2.0 0.50 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.50 0.30 1.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.50 0.30 1.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Obstaculo derecho -->

    <model name="obstaculo_derecho">
      <static>true</static>

      <pose>0.0 -2.0 0.50 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.50 0.30 1.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.50 0.30 1.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>

</sdf>