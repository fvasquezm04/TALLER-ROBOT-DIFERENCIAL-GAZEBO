<?xml version="1.0"?>

<sdf version="1.9">

  <world name="pista">

    <!-- ================================================== -->
    <!-- CONFIGURACIÓN GENERAL DEL MUNDO                    -->
    <!-- ================================================== -->

    <physics name="fisica" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1.0</ambient>
      <background>0.70 0.80 0.90 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">

      <pose>0 0 12 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>0.90 0.90 0.90 1.0</diffuse>
      <specular>0.20 0.20 0.20 1.0</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.2 -0.9</direction>

    </light>


    <!-- ================================================== -->
    <!-- SUELO                                              -->
    <!-- ================================================== -->

    <model name="suelo">

      <static>true</static>

      <link name="suelo_link">

        <collision name="suelo_collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>18 11</size>
            </plane>
          </geometry>

        </collision>

        <visual name="suelo_visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>18 11</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.18 0.20 0.22 1.0</ambient>
            <diffuse>0.18 0.20 0.22 1.0</diffuse>
            <specular>0.03 0.03 0.03 1.0</specular>
          </material>

        </visual>

      </link>

    </model>


