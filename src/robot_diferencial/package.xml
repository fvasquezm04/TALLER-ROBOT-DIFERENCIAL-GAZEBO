<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>robot_diferencial</name>
  <version>0.0.0</version>

  <description>
    Simulacion de un robot movil diferencial con ROS 2 y Gazebo.
  </description>

  <maintainer email="fvmartinezfv@gmail.com">
    fvasquezm04
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Dependencias de los nodos desarrollados en Python -->

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>rosgraph_msgs</depend>

  <!-- Dependencias para archivos launch -->

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Descripcion y visualizacion del robot -->

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Integracion entre ROS 2 y Gazebo -->

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Teleoperacion y visualizacion de imagenes -->

  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>image_transport</exec_depend>

  <!-- Dependencias de pruebas -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>